# Halcyon local development environment
# Copy to .env and adjust as needed

# Application environment
APP_ENV=development

# Auth service
AUTH_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json
SERVICE_NAME=auth

# Organization service
ORGANIZATION_PORT=8081

ORGANIZATION_DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon_organization?sslmode=disable
ORGANIZATION_DATABASE_MIGRATE=true
AUTH_SERVICE_NAME=auth

# JWT authentication (required when DATABASE_URL is set)
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Argon2id password hashing
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# PostgreSQL (docker compose)
POSTGRES_USER=halcyon
POSTGRES_PASSWORD=halcyon
POSTGRES_DB=halcyon
POSTGRES_PORT=5432
DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon?sslmode=disable
DATABASE_MIGRATE=true
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=30m

# Redis (docker compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Kafka-compatible (Redpanda, docker compose)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=halcyon-local
KAFKA_CONSUMER_GROUP=organization-audit-consumer
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS_ENABLED=false

# Outbox relay
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# Event consumer retry / DLQ
EVENT_MAX_RETRIES=4
EVENT_RETRY_BACKOFF=100ms
EVENT_DLQ_ENABLED=true
CONSUMER_CONCURRENCY=4
KAFKA_TOPIC=halcyon.organizations

# Gateway service
GATEWAY_PORT=8088
AUTH_SERVICE_URL=http://localhost:8080
ORG_SERVICE_URL=http://localhost:8081
JWKS_URL=http://localhost:8080/api/v1/auth/jwks
JWKS_CACHE_TTL=5m
JWT_ISSUER=auth
JWT_AUDIENCE=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_REDIS_PREFIX=gateway:ratelimit
RATE_LIMIT_DEFAULT_REQUESTS=300
RATE_LIMIT_DEFAULT_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_WORKFLOW_REQUESTS=30
RATE_LIMIT_WORKFLOW_WINDOW=1m
WORKFLOW_CONCURRENCY_LIMIT=8
# Legacy aliases still supported:
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_INVITATION=30
RATE_LIMIT_WINDOW=1m
REQUEST_MAX_BODY_BYTES=1048576
MAX_REQUEST_BODY_BYTES=1048576

# Idempotency (requires Redis for multi-instance deduplication)
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_IN_PROGRESS_TTL=5m
IDEMPOTENCY_COMPLETED_TTL=24h
IDEMPOTENCY_MAX_RESPONSE_SIZE=65536
IDEMPOTENCY_FAIL_CLOSED=true
IDEMPOTENCY_REDIS_PREFIX=halcyon:idempotency

# Workflow service
WORKFLOW_PORT=8082
WORKFLOW_DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon_workflow?sslmode=disable
WORKFLOW_DATABASE_MIGRATE=true

# Audit service
AUDIT_PORT=8083
AUDIT_DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon_audit?sslmode=disable
AUDIT_DATABASE_MIGRATE=true

# Integrations service
INTEGRATIONS_PORT=8084
INTEGRATIONS_DATABASE_MIGRATE=true
# Required in production — 32-byte secret for webhook credential encryption
INTEGRATIONS_ENCRYPTION_KEY=change-me-integrations-encryption-key-32b

# Notifications service
NOTIFICATIONS_PORT=8085
NOTIFICATIONS_DATABASE_MIGRATE=true

# Jobs API service
JOBS_PORT=8086

JOBS_DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon_jobs?sslmode=disable
JOBS_DATABASE_MIGRATE=true
JOB_WORKER_ENABLED=true
JOB_WORKER_COUNT=1
JOB_MAX_CONCURRENT=8
JOB_BATCH_SIZE=10
JOB_POLL_INTERVAL=1s
JOB_LEASE_DURATION=30s
JOB_LEASE_RENEW_INTERVAL=10s
JOB_SHUTDOWN_TIMEOUT=30s
JOB_MAX_ATTEMPTS=6
JOB_EXECUTION_TIMEOUT=5m
JOB_RETRY_BASE_DELAY=1s
JOB_RETRY_MAX_DELAY=5m
JOB_RETRY_JITTER=0.5
JOB_SUCCESS_RETENTION_DAYS=7
JOB_FAILURE_RETENTION_DAYS=30
INTEGRATIONS_DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon_integrations?sslmode=disable
NOTIFICATIONS_DATABASE_URL=postgres://halcyon:halcyon@localhost:5432/halcyon_notifications?sslmode=disable

UPSTREAM_TIMEOUT=30s
CIRCUIT_BREAKER_ENABLED=true
SERVICE_IDENTITY=gateway
SERVICE_KEY_ID=gateway-1
SERVICE_TOKEN_AUDIENCE=halcyon-internal
SERVICE_TOKEN_ISSUER=gateway
SERVICE_TOKEN_TTL=5m
# Downstream services validate gateway-issued service tokens with this public key.
# When unset, derived from SERVICE_PRIVATE_KEY in local development only.
SERVICE_TOKEN_PUBLIC_KEY=
# Generate with: openssl genrsa 2048 (PEM format, single line or multiline)
SERVICE_PRIVATE_KEY=

# Demo mode (portfolio / public demo)
# Run scripts/demo-bootstrap.ps1 after docker compose is healthy, then start apps/web with VITE_DEMO_MODE=true.
DEMO_MODE=false

# OpenTelemetry tracing (optional — start collector with: docker compose --profile observability up -d otel-collector)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=halcyon-local
SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_SHUTDOWN_TIMEOUT=10s

# Test/CI environment (use APP_ENV=test in CI)
