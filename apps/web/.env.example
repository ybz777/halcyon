# Halcyon web console — copy to .env.local for local overrides.
# VITE_* variables are embedded in the production build and are public.

# Set to true for the public portfolio demo (auto-login, no setup wizard).
VITE_DEMO_MODE=false

# Demo identity (populated by scripts/demo-bootstrap.ps1 after first run).
VITE_DEMO_EMAIL=demo@halcyon.demo
VITE_DEMO_PASSWORD=HalcyonDemo!2026
VITE_DEMO_ORG_ID=
VITE_DEMO_SERVICE_ACCOUNT_ID=svc_demoGatewayBot001

# Optional API base URL for production when the API is on another origin.
# Leave empty for same-origin (recommended behind a reverse proxy).
VITE_API_BASE_URL=
